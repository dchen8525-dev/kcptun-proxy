{
  "name": "kcptun-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "kcptun-proxy tunnel desktop shell (Electron) - drives the Go kcptun-client",
  "main": "electron/main.cjs",
  "scripts": {
    "build:desktop": "node scripts/copy-binary.mjs",
    "start": "node scripts/copy-binary.mjs && node scripts/start-electron.cjs",
    "pack": "node scripts/copy-binary.mjs && electron-builder --win portable --x64",
    "pack:dir": "node scripts/copy-binary.mjs && electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "com.kcptun.desktop",
    "asar": false,
    "productName": "KCPtun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "KCPtun-${version}-portable.exe"
    },
    "compression": "maximum"
  }
}
